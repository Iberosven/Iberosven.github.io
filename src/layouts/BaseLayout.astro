---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import MobileContact from '../components/MobileContact.astro';
import '../styles/global.css';
import { languages } from '../i18n/ui';

interface Props {
  title: string;
  lang: keyof typeof languages;
}

const { title, lang } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,700,600,500&display=swap" rel="stylesheet">
    <title>{title} | Iberosur</title>
    <ClientRouter />
  </head>
  <body class="bg-cream text-charcoal font-sans min-h-screen selection:bg-brand-yellow selection:text-brand-red">
    <Navigation lang={lang} />
    
    <main class="min-h-screen">
      <slot />
    </main>

    <footer class="bg-charcoal text-cream pt-24 pb-12">
      <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-12 mb-16">
          <div class="col-span-2">
            <div class="text-brand-yellow font-display font-bold text-4xl mb-4 uppercase">Iberosur</div>
            <p class="text-cream/60 max-w-sm text-lg">
              Expertos en experiencias turísticas personalizadas en la Costa del Sol. Descubre Málaga con los que mejor la conocen.
            </p>
          </div>
          <div>
            <h4 class="text-brand-yellow mb-6">Enlaces</h4>
            <ul class="space-y-4 text-cream/80">
              <li><a href="#services" class="hover:text-brand-yellow transition-colors">Servicios</a></li>
              <li><a href="#about" class="hover:text-brand-yellow transition-colors">Sobre nosotros</a></li>
              <li><a href="#contact" class="hover:text-brand-yellow transition-colors">Contacto</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-brand-yellow mb-6">Contacto</h4>
            <ul class="space-y-4 text-cream/80">
              <li>Málaga, España</li>
              <li>info@iberosur.com</li>
              <li>+34 600 000 000</li>
            </ul>
          </div>
        </div>
        <div class="border-t border-cream/10 pt-8 text-center text-cream/40 text-sm">
          <p>&copy; {new Date().getFullYear()} Iberosur. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>

    <MobileContact />

    <script>
      function setupReveal() {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
      }

      // Run on page load and after View Transitions
      setupReveal();
      document.addEventListener('astro:after-swap', setupReveal);
    </script>
  </body>
</html>
