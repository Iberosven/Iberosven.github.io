---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('legal', e => e.data.lang === 'nl');
  return pages.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={entry.data.title} lang="nl">
  <section class="min-h-screen pt-40 pb-32 bg-cream">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto">
        <a href={`${baseUrl}nl/`} class="inline-flex items-center gap-2 text-sm font-bold text-charcoal/50 hover:text-brand-red transition-colors mb-10">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Home
        </a>
        <div class="prose">
          <Content />
        </div>
        {entry.data.lastUpdated && (
          <p class="mt-12 text-xs text-charcoal/30 border-t border-charcoal/10 pt-6">
            Laatste update: {entry.data.lastUpdated}
          </p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
