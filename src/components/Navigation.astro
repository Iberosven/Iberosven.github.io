---
import { languages, ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof languages;
}

const { lang } = Astro.props;
const t = ui[lang];
const baseUrl = import.meta.env.BASE_URL;
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-6">
  <div class="container mx-auto flex justify-between items-center glass rounded-2xl px-6 py-3 shadow-lg">
    <a href={`${baseUrl}${lang}/`} class="flex items-center gap-2 group">
      <div class="w-10 h-10 bg-brand-yellow rounded-lg flex items-center justify-center font-black text-brand-red text-xl shadow-sm group-hover:scale-105 transition-transform">
        I
      </div>
      <span class="text-brand-red font-display font-bold text-2xl uppercase tracking-tighter">
        Iberosur
      </span>
    </a>

    <nav class="hidden md:block">
      <ul class="flex gap-8 items-center">
        <li><a href={`${baseUrl}${lang}/#services`} class="font-medium hover:text-brand-red transition-colors">{t['nav.services']}</a></li>
        <li><a href={`${baseUrl}${lang}/#about`} class="font-medium hover:text-brand-red transition-colors">{t['nav.about']}</a></li>
        <li><a href={`${baseUrl}${lang}/#contact`} class="font-medium hover:text-brand-red transition-colors">{t['nav.contact']}</a></li>
        
        <li class="h-6 w-px bg-charcoal/10 mx-2"></li>
        
        <li class="flex gap-3">
          {Object.entries(languages).map(([l, label]) => (
            <a 
              href={`${baseUrl}${l}/`} 
              class={`text-xs font-bold px-2 py-1 rounded-md transition-all ${l === lang ? 'bg-brand-red text-white' : 'text-charcoal/60 hover:text-brand-red hover:bg-brand-yellow/20'}`}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </li>
      </ul>
    </nav>

    <button class="md:hidden text-brand-red p-2" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('py-2');
    } else {
      header?.classList.remove('py-2');
    }
  });
</script>
