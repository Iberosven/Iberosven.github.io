---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image: string;
  tag?: string;
  class?: string;
}

const { title, description, image, tag, class: className } = Astro.props;
---

<div class={`group relative bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 reveal-on-scroll ${className ?? ''}`}>
  <div class="relative h-56 overflow-hidden">
    <div class="absolute inset-0 bg-brand-red/10 group-hover:bg-transparent transition-colors z-10"></div>
    <Image
      src={image}
      alt={title}
      width={800}
      height={600}
      format="webp"
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
    />
    {tag && (
      <span class="absolute top-4 left-4 z-20 bg-brand-yellow text-brand-red text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
        {tag}
      </span>
    )}
  </div>

  <div class="p-8">
    <h3 class="text-xl font-display font-bold uppercase tracking-wide text-brand-red mb-3 group-hover:text-charcoal transition-colors leading-snug">
      {title}
    </h3>
    <p class="text-charcoal/60 leading-relaxed">{description}</p>
  </div>
</div>
