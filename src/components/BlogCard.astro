---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  image?: string;
  imageAlt?: string;
  tags: string[];
  slug: string;
  lang: string;
  readMore: string;
}

const { title, description, pubDate, image, imageAlt, tags, slug, lang, readMore } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const formattedDate = pubDate.toLocaleDateString(
  lang === 'es' ? 'es-ES' : lang === 'nl' ? 'nl-NL' : 'en-GB',
  { year: 'numeric', month: 'long', day: 'numeric' }
);
---

<article class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 reveal-on-scroll flex flex-col">
  {image && (
    <div class="relative h-52 overflow-hidden flex-shrink-0">
      <div class="absolute inset-0 bg-brand-red/10 group-hover:bg-transparent transition-colors z-10"></div>
      <img
        src={image}
        alt={imageAlt ?? title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    </div>
  )}

  <div class="p-8 flex flex-col flex-1">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.slice(0, 3).map(tag => (
          <span class="text-xs font-bold uppercase tracking-wider text-brand-red bg-brand-yellow/20 px-3 py-1 rounded-full">
            {tag}
          </span>
        ))}
      </div>
    )}

    <h2 class="text-xl font-display font-bold text-charcoal group-hover:text-brand-red transition-colors mb-3 leading-snug">
      {title}
    </h2>

    <p class="text-charcoal/60 text-sm leading-relaxed mb-6 flex-1 line-clamp-3">
      {description}
    </p>

    <div class="flex items-center justify-between mt-auto pt-4 border-t border-charcoal/10">
      <time class="text-xs text-charcoal/40 font-medium">{formattedDate}</time>
      <a
        href={`${baseUrl}${lang}/blog/${slug}/`}
        class="text-sm font-bold text-brand-red hover:text-charcoal transition-colors flex items-center gap-1 group/link"
      >
        {readMore}
        <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
